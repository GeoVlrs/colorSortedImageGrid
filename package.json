    "cli-progress": "^3.12.0",
    "culori": "^4.0.2",
    "exifr": "^7.1.3",
    "gifenc": "^1.0.3",
    "jimp": "^0.22.10",
    "picocolors": "^1.1.1",
    "quantize": "^1.0.2",
    "yargs": "^17.7.3"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test \"test/*.test.js\""
  },
  "repository": {
